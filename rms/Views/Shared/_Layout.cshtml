<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Barangay Risk Management</title>
    <link rel="stylesheet" href="~/css/evacuees.css" />
    <link rel="stylesheet" href="~/css/evacuees-modal.css" />
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
</head>
<body>
    @RenderBody()

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>

    <div id="addFamilyModal" class="modal">
        <div class="modal-content">
            <span class="close-btn">&times;</span>
            <h2>Add Family Record</h2>
            <form>
                <label>Head of Family Name</label>
                <input type="text" placeholder="Enter name">

                <label>Address</label>
                <input type="text" placeholder="Enter address">

                <label>Contact Number</label>
                <input type="text" placeholder="Enter contact number">

                <label>Disaster Type</label>
                <input type="text" placeholder="Enter disaster type">

                <label>Evacuation Center Assigned</label>
                <input type="text" placeholder="Enter evacuation center">

                <label>Total Family Members</label>
                <input type="number" placeholder="Enter total">

                <label>No. of Senior Citizens</label>
                <input type="number" placeholder="Enter count">

                <label>No. of PWD</label>
                <input type="number" placeholder="Enter count">

                <label>No. of Children</label>
                <input type="number" placeholder="Enter count">

                <button type="submit" class="submit-btn">Save Record</button>
            </form>
        </div>
    </div>


</body>
</html>

            