<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Barangay Risk Management</title>
    <link rel="stylesheet" href="~/css/evacuees.css" />
    <link rel="stylesheet" href="~/css/evacuees-modal.css" />
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
</head>
<body>
    @RenderBody()

    <div id="addFamilyModal" class="modal">
        <div class="modal-content">
            <span class="close-btn">&times;</span>
            
            <div class="modal-header">
                <img src="~/imgs/LOGO (1).png" alt="Barangay Seal" class="modal-logo">
                <div class="modal-header-text">
                    <span class="modal-barangay-name">San Bartolome Barangay Hall</span>
                    <span class="modal-risk-management">Risk Management</span>
                </div>
            </div>

            <form id="familyForm">
                <div id="errorMessage" class="error-message" style="display: none;"></div>
                <div class="form-grid">
                    <div class="form-left">
                        <div class="form-group">
                            <label>Head of Family Name</label>
                            <input type="text" id="headOfFamily" placeholder="" required>
                        </div>

                        <div class="form-group">
                            <label>Address</label>
                            <input type="text" id="address" placeholder="" required>
                        </div>

                        <div class="form-group">
                            <label>Contact Number</label>
                            <input type="text" id="contactNumber" placeholder="" required>
                        </div>

                        <div class="form-group">
                            <label>Disaster Type</label>
                            <input type="text" id="disasterType" placeholder="" required>
                        </div>

                        <div class="form-group">
                            <label>Evacuation Center Assigned</label>
                            <input type="text" id="evacuationCenter" placeholder="" required>
                        </div>
                    </div>

                    <div class="form-right">
                        <div class="form-group">
                            <label>Total Family Numbers</label>
                            <input type="number" id="totalFamilyNumbers" placeholder="" required>
                        </div>

                        <div class="form-group">
                            <label>No. of Senior Citizens</label>
                            <input type="number" id="seniorCitizens" placeholder="" required>
                        </div>

                        <div class="form-group">
                            <label>No. of PWD</label>
                            <input type="number" id="pwd" placeholder="" required>
                        </div>

                        <div class="form-group">
                            <label>No. of Children</label>
                            <input type="number" id="children" placeholder="" required>
                        </div>
                    </div>
                </div>

                <button type="submit" class="submit-btn">Submit</button>
            </form>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>

</body>
</html>

            